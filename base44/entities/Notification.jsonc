{
  "name": "Notification",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "request_update",
        "invoice_created",
        "announcement",
        "poll_deadline",
        "payment_confirmed",
        "election"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "related_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "type",
    "title"
  ]
}