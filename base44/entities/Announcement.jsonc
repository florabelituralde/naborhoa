{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "author_id": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "community_id",
    "title",
    "body",
    "author_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.community_id": "{{user.data.community_id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    }
  }
}