{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "join_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "monthly_dues": {
      "type": "number",
      "default": 0
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "plan_id": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "growth",
        "pro",
        "pro_multi"
      ]
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual"
      ]
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "ended"
      ],
      "default": "pending"
    },
    "platform_subscription_id": {
      "type": "string"
    },
    "platform_checkout_id": {
      "type": "string"
    },
    "stripe_account_id": {
      "type": "string"
    },
    "stripe_account_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "restricted",
        "enabled"
      ],
      "default": "none"
    },
    "charges_enabled": {
      "type": "boolean",
      "default": false
    },
    "payouts_enabled": {
      "type": "boolean",
      "default": false
    },
    "stripe_details_submitted": {
      "type": "boolean",
      "default": false
    },
    "accepted_payment_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "card",
          "ach"
        ]
      },
      "default": [
        "card"
      ]
    },
    "apply_late_fees": {
      "type": "boolean",
      "default": false
    },
    "late_fee_amount": {
      "type": "number",
      "default": 0
    },
    "late_fee_grace_days": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "organization_id",
    "join_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.board_member_status": "approved"
              }
            },
            {
              "data.id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    }
  }
}