{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "author_id": {
      "type": "string"
    }
  },
  "required": [
    "community_id",
    "title",
    "body",
    "author_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}