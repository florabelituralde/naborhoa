{
  "name": "Request",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "homeowner_id": {
      "type": "string"
    },
    "request_type_id": {
      "type": "string"
    },
    "request_type_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "plan_review",
        "other"
      ],
      "default": "maintenance"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_progress",
        "resolved",
        "cancelled",
        "approved",
        "info_requested"
      ],
      "default": "submitted"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assignee_type": {
      "type": "string",
      "enum": [
        "none",
        "vendor",
        "other"
      ],
      "default": "none"
    },
    "assignee_info": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "info_request": {
      "type": "string"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "custom_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "resolution_notes": {
      "type": "string"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "created",
              "status_change",
              "assigned",
              "unassigned",
              "note"
            ]
          },
          "label": {
            "type": "string"
          },
          "actor_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "community_id",
    "homeowner_id",
    "title",
    "description",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    }
  }
}