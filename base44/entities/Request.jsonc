{
  "name": "Request",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "homeowner_id": {
      "type": "string"
    },
    "request_type_id": {
      "type": "string"
    },
    "request_type_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "plan_review",
        "other"
      ],
      "default": "maintenance"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_progress",
        "resolved",
        "cancelled"
      ],
      "default": "submitted"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "assigned_to_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "custom_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "resolution_notes": {
      "type": "string"
    },
    "activity_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "created",
              "status_change",
              "assigned",
              "unassigned",
              "note"
            ]
          },
          "label": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "community_id",
    "homeowner_id",
    "title",
    "description",
    "category"
  ]
}