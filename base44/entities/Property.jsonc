{
  "name": "Property",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    }
  },
  "required": [
    "community_id",
    "address"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.community_id": "{{user.data.community_id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    }
  }
}