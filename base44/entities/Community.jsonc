{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "join_code": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "monthly_dues": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "organization_id",
    "join_code"
  ]
}