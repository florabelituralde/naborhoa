{
  "name": "Event",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "meeting",
        "social",
        "deadline"
      ],
      "default": "meeting"
    },
    "created_by_id": {
      "type": "string"
    }
  },
  "required": [
    "community_id",
    "title",
    "start_time",
    "end_time",
    "created_by_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.community_id": "{{user.data.community_id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "board_member_status": "approved"
              }
            },
            {
              "data.community_id": "{{user.data.community_id}}"
            }
          ]
        }
      ]
    }
  }
}