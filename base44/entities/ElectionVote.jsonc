{
  "name": "ElectionVote",
  "type": "object",
  "properties": {
    "election_id": {
      "type": "string"
    },
    "voter_id": {
      "type": "string"
    },
    "candidate_index": {
      "type": "number"
    },
    "position": {
      "type": "string",
      "enum": [
        "president",
        "vice_president",
        "treasurer",
        "secretary",
        "member_at_large"
      ]
    }
  },
  "required": [
    "election_id",
    "voter_id",
    "candidate_index",
    "position"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}