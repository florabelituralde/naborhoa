{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "homeowner_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Homeowner email captured at invoice creation for guest portal verification"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "confirmed",
        "overdue"
      ],
      "default": "pending"
    },
    "type": {
      "type": "string",
      "enum": [
        "dues",
        "assessment",
        "fee",
        "fine"
      ],
      "default": "dues"
    },
    "payment_proof_url": {
      "type": "string"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "wix_checkout_id": {
      "type": "string"
    },
    "wix_order_id": {
      "type": "string"
    }
  },
  "required": [
    "community_id",
    "amount",
    "description",
    "due_date",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    }
  }
}