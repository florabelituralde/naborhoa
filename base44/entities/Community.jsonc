{
  "name": "Community",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "join_code": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "monthly_dues": {
      "type": "number",
      "default": 0
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "plan_id": {
      "type": "string",
      "enum": [
        "starter",
        "growth",
        "pro"
      ]
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual"
      ]
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "canceled",
        "ended"
      ],
      "default": "pending"
    },
    "platform_subscription_id": {
      "type": "string"
    },
    "platform_checkout_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "organization_id",
    "join_code"
  ]
}