{
  "name": "MoveOutRequest",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "community_name": {
      "type": "string"
    },
    "homeowner_id": {
      "type": "string"
    },
    "homeowner_name": {
      "type": "string"
    },
    "homeowner_email": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "move_out_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string",
      "enum": [
        "selling",
        "relocating",
        "renting",
        "other"
      ],
      "default": "selling"
    },
    "buyer_name": {
      "type": "string"
    },
    "forwarding_email": {
      "type": "string"
    },
    "forwarding_address": {
      "type": "string",
      "description": "Homeowner's new mailing address for final correspondence"
    },
    "forwarding_phone": {
      "type": "string",
      "description": "Contact phone for closing-related questions"
    },
    "utility_info": {
      "type": "string",
      "description": "Utility provider / account number / transfer status"
    },
    "keys_status": {
      "type": "string",
      "enum": [
        "returned",
        "pending",
        "not_applicable"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "community_id",
    "homeowner_id",
    "move_out_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.homeowner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    }
  }
}