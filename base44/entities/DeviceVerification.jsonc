{
  "name": "DeviceVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "code_hash": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "code_hash",
    "expires_at"
  ]
}