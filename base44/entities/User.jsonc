{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "hoa_admin",
        "hoa_staff",
        "homeowner"
      ]
    },
    "organization_id": {
      "type": "string"
    },
    "community_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "board_member_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none"
    },
    "requested_board_role": {
      "type": "string",
      "enum": [
        "president",
        "vice_president",
        "treasurer",
        "secretary",
        "member_at_large"
      ]
    }
  }
}