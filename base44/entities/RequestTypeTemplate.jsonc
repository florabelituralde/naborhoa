{
  "name": "RequestTypeTemplate",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "default": "Wrench"
    },
    "category": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "plan_review",
        "other"
      ],
      "default": "maintenance"
    },
    "requires_attachment": {
      "type": "boolean",
      "default": false
    },
    "attachment_label": {
      "type": "string",
      "default": "Attachments (photos, plans, documents)"
    },
    "custom_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "select"
            ],
            "default": "text"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        },
        "required": [
          "label",
          "type"
        ]
      },
      "default": []
    }
  },
  "required": [
    "community_id",
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}