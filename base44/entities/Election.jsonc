{
  "name": "Election",
  "type": "object",
  "properties": {
    "community_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "photo_url": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "homeowner_id": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "created_by_id": {
      "type": "string"
    },
    "promoted": {
      "type": "boolean",
      "default": false
    },
    "promoted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "community_id",
    "title",
    "candidates",
    "end_date",
    "created_by_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.community_id": "{{user.data.community_id}}"
        },
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "hoa_admin"
          }
        },
        {
          "user_condition": {
            "role": "hoa_staff"
          }
        }
      ]
    }
  }
}